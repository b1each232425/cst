{
	"name": "3min-fe",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest run --project=unit --coverage --reporter=verbose --reporter=html",
		"test:server": "vitest run --project=server",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.33.0",
		"@fontsource/fira-mono": "^5.2.6",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.54.2",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.27.3",
		"@sveltejs/vite-plugin-svelte": "^6.1.1",
		"@testing-library/jest-dom": "^6.6.4",
		"@testing-library/svelte": "^5.2.8",
		"@types/eslint": "^9.6.1",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"c8": "^10.1.3",
		"eslint": "^9.33.0",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.3.0",
		"jsdom": "^26.1.0",
		"msw": "^2.10.4",
		"playwright": "^1.54.2",
		"prettier": "^3.6.2",
		"sass": "^1.90.0",
		"svelte": "^5.38.0",
		"svelte-check": "^4.3.1",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.9.2",
		"vite": "^7.1.1",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@3min/cst-tiptap": "^1.2.2",
		"@3min/smart-edit": "^1.5.2",
		"@testing-library/svelte": "^5.2.8",
		"bulma": "^1.0.4",
		"echarts": "^6.0.0",
